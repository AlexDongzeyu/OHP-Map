{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Crestwood OHP survivors.geojson",
  "description": "One feature per public profile. Unplaced profiles use null geometry and empty waypoints; coordinate order is [lng, lat].",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "metadata": { "type": "object" },
    "features": {
      "type": "array",
      "items": { "$ref": "#/definitions/survivor" }
    }
  },
  "definitions": {
    "survivor": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": {
          "type": ["object", "null"],
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Point" },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          }
        },
        "properties": {
          "type": "object",
          "required": ["survivor_id", "name", "archive_url", "theme_tags", "waypoints"],
          "properties": {
            "survivor_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "source_aliases": {
              "type": "array", "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
            },
            "name": { "type": "string", "minLength": 1 },
            "is_sample": { "type": "boolean" },
            "birth_year": { "type": ["integer", "null"] },
            "bio_excerpt": { "type": "string" },
            "archive_url": { "type": "string", "format": "uri" },
            "media_url": { "type": ["string", "null"] },
            "portrait": { "type": ["string", "null"] },
            "portrait_rights": { "type": ["string", "null"] },
            "portrait_faces": { "type": "integer", "minimum": 0 },
            "video_count": { "type": "integer", "minimum": 0 },
            "video_inventory": { "type": "string", "pattern": "^[0-9]+:[0-9a-f]{8}$" },
            "video_source_inventory": { "type": "string", "pattern": "^[0-9]+:[0-9a-f]{8}$" },
            "captioned_video_count": { "type": "integer", "minimum": 0 },
            "transcript_status": {
              "type": "string",
              "enum": ["complete", "partial", "none", "unavailable", "pending"]
            },
            "theme_tags": { "type": "array", "items": { "type": "string" } },
            "profile_media": { "$ref": "#/definitions/profile_media" },
            "waypoints": {
              "type": "array",
              "items": { "$ref": "#/definitions/waypoint" }
            }
          },
          "additionalProperties": true
        }
      },
      "allOf": [{
        "if": {
          "properties": {
            "properties": { "properties": { "waypoints": { "maxItems": 0 } } }
          }
        },
        "then": { "properties": { "geometry": { "type": "null" } } },
        "else": { "properties": { "geometry": { "type": "object" } } }
      }]
    },
    "profile_media": {
      "type": "object",
      "required": ["images", "videos"],
      "additionalProperties": false,
      "properties": {
        "images": {
          "type": "array",
          "items": { "$ref": "#/definitions/profile_image" }
        },
        "videos": {
          "type": "array",
          "items": { "$ref": "#/definitions/profile_video" }
        }
      }
    },
    "profile_image": {
      "type": "object",
      "required": ["url", "source_url", "caption", "credit", "rights"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(?:assets/portraits/[a-z0-9-]+\\.webp|https://ohp\\.crestwood\\.on\\.ca/wp-content/uploads/[^?#]+)$"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://ohp\\.crestwood\\.on\\.ca/wp-content/uploads/[^?#]+$"
        },
        "full_url": {
          "type": "string",
          "pattern": "^https://ohp\\.crestwood\\.on\\.ca/wp-content/uploads/[^?#]+$"
        },
        "caption": { "type": "string", "minLength": 1 },
        "credit": { "type": "string", "minLength": 1 },
        "rights": { "type": "string", "minLength": 1 },
        "primary": { "type": "boolean" }
      }
    },
    "profile_video": {
      "type": "object",
      "required": ["id", "url", "embed_url", "title", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]+$" },
        "url": {
          "type": "string",
          "pattern": "^https://player\\.vimeo\\.com/video/[0-9]+(?:\\?[^#]*)?$"
        },
        "embed_url": {
          "type": "string",
          "pattern": "^https://player\\.vimeo\\.com/video/[0-9]+(?:\\?[^#]*)?$"
        },
        "title": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["captioned", "no-public-captions", "unavailable", "caption-track-unavailable", "pending", "error"]
        },
        "language": { "type": "string" }
      }
    },
    "waypoint": {
      "type": "object",
      "required": ["as_written", "canonical", "role", "lat", "lng", "date", "confidence", "verified"],
      "properties": {
        "as_written": { "type": "string", "minLength": 1 },
        "canonical": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": ["birthplace", "ghetto", "camp", "transit", "liberation", "resettlement"]
        },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "date": {
          "type": "object",
          "required": ["start", "end", "precision"],
          "properties": {
            "start": { "type": ["string", "null"] },
            "end": { "type": ["string", "null"] },
            "precision": { "type": "string", "enum": ["day", "month", "year", "range", "unknown"] }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "verified": { "type": "boolean" },
        "source_quote": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  }
}
